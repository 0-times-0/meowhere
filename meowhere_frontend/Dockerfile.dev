# Środowisko developerskie frontendu MEOWHERE (React + Vite) w kontenerze.
FROM node:22-alpine

WORKDIR /app

# Najpierw same manifesty - warstwa z node_modules przetrwa edycje kodu
# i nie będzie instalowana od nowa przy każdym buildzie.
COPY package*.json ./
RUN npm install

# Reszta kodu. W runtime i tak jest nadpisywana bind-mountem z hosta,
# ale trzymamy to jako fallback (np. pierwsze uruchomienie bez wolumenu).
COPY . .

EXPOSE 5173

# --host 0.0.0.0 => serwer widoczny poza kontenerem (mapowanie 5173:5173 w compose).
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
